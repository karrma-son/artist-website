{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "./src",
    "outDir": "./dist",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,
    "types": ["node", "vitest/globals"]
  },
  "include": [
    "src/**/*",
    "src/__tests__/**/*",
    "vite.config.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
